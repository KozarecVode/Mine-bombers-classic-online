{
  "name": "@minebombers/electron",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --external:electron --outfile=dist/main.js && esbuild src/preload.ts --bundle --platform=node --external:electron --outfile=dist/preload.js",
    "start": "electron .",
    "pack": "node scripts/pack.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "electron": "28.3.3",
    "esbuild": "^0.20.0",
    "ws": "^8.17.0"
  }
}
